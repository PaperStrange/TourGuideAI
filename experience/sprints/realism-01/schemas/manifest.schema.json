{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "realism-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "status", "protocol", "route", "requiredTurnRegions", "interactionPlan", "runOrder", "candidates", "devices", "prerequisites", "finalComparison"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "BenchmarkManifest" },
    "id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "frozen"] },
    "protocol": { "const": "realism-v1" },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "lengthMetres", "edgeCount", "sightCount"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "lengthMetres": { "const": 1353.444059858351 },
        "edgeCount": { "const": 54 }, "sightCount": { "const": 6 }
      }
    },
    "candidates": { "type": "array", "items": { "$ref": "#/definitions/candidate" } },
    "interactionPlan": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["actionId", "edgeIndex", "direction", "kind"],
        "properties": {
          "actionId": { "type": "string", "minLength": 1 },
          "edgeIndex": { "type": "integer", "minimum": 0, "maximum": 53 },
          "direction": { "enum": ["forward", "reverse"] },
          "kind": { "enum": ["walk", "turn"] }
        }
      }
    },
    "runOrder": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidateId", "deviceId", "locale", "lighting", "session"],
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "deviceId": { "enum": ["windows-iris-xe", "macbook-air-m1"] },
          "locale": { "enum": ["en", "zh"] },
          "lighting": { "enum": ["day", "night"] },
          "session": { "type": "integer", "minimum": 1, "maximum": 3 }
        }
      }
    },
    "requiredTurnRegions": {
      "type": "array", "minItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sightId", "edgeIndex"],
        "properties": {
          "sightId": { "type": "string", "minLength": 1 },
          "edgeIndex": { "type": "integer", "minimum": 0, "maximum": 53 }
        }
      }
    },
    "devices": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "$ref": "#/definitions/device" }
    },
    "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "finalComparison": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "candidateIds", "costReferenceHours", "costReferenceCash", "currency", "costEvidence"],
      "properties": {
        "kind": { "enum": ["renderer", "product", "absolute"] },
        "candidateIds": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "costReferenceHours": { "type": ["number", "null"], "minimum": 1 },
        "costReferenceCash": { "type": ["number", "null"], "minimum": 1 },
        "currency": { "type": ["string", "null"], "minLength": 3 },
        "costEvidence": { "type": "array", "items": { "$ref": "#/definitions/evidence" } }
      }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identity": { "type": ["string", "null"], "minLength": 1 },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["buildCommit", "assetManifestSha256", "sourceManifestSha256", "cameraSha256", "groundCollisionSha256", "interfaceSha256", "qualitySha256", "requiredStartingDetailSha256", "driverSha256"],
      "properties": {
        "buildCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "assetManifestSha256": { "$ref": "#/definitions/sha256" },
        "sourceManifestSha256": { "$ref": "#/definitions/sha256" },
        "cameraSha256": { "$ref": "#/definitions/sha256" },
        "groundCollisionSha256": { "$ref": "#/definitions/sha256" },
        "interfaceSha256": { "$ref": "#/definitions/sha256" },
        "qualitySha256": { "$ref": "#/definitions/sha256" },
        "requiredStartingDetailSha256": { "$ref": "#/definitions/sha256" },
        "driverSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "binding", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "binding": { "$ref": "#/definitions/binding" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/evidence" } }
      }
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "profile", "hardware", "operatingSystem", "browser", "graphicsDriver", "powerMode"],
      "properties": {
        "id": { "enum": ["windows-iris-xe", "macbook-air-m1"] },
        "profile": { "type": "string", "minLength": 1 },
        "hardware": { "$ref": "#/definitions/identity" },
        "operatingSystem": { "$ref": "#/definitions/identity" },
        "browser": { "$ref": "#/definitions/identity" },
        "graphicsDriver": { "$ref": "#/definitions/identity" },
        "powerMode": { "$ref": "#/definitions/identity" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "source", "date", "rights", "location", "method", "limitations"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "source": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 },
        "rights": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "limitations": { "type": "string", "minLength": 1 }
      }
    }
  }
}
